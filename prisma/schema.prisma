datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
  BANNED
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  FINANCE
  SUPPORT
  CLIENT
  FREELANCER
  AGENCY_ADMIN
  AGENCY_MEMBER
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}

enum BudgetType {
  FIXED
  HOURLY
}

enum JobStatus {
  DRAFT
  PUBLISHED
  IN_REVIEW
  IN_PROGRESS
  COMPLETED
  PAUSED
  CLOSED
  CANCELLED
}

enum ProposalStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  DISPUTED
  TERMINATED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  RELEASED
  DISPUTED
  CANCELLED
}

enum DeliverableStatus {
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED
}

enum TransactionType {
  DEPOSIT
  ESCROW_HOLD
  ESCROW_RELEASE
  PLATFORM_FEE
  WITHDRAWAL
  REFUND
  BONUS
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_FOR_CLIENT
  WAITING_FOR_FREELANCER
  RESOLVED
  ESCALATED
  CLOSED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

// -------------------------------------------------------------
// USER & AUTHENTICATION
// -------------------------------------------------------------

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  username        String       @unique
  passwordHash    String       @map("password_hash")
  phone           String?
  status          UserStatus   @default(ACTIVE)
  emailVerified   Boolean      @default(false) @map("email_verified")
  avatarUrl       String?      @map("avatar_url")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  // Relations
  roles           UserRole[]
  sessions        Session[]
  loginAttempts   LoginAttempt[]
  profile         Profile?
  freelancerProfile FreelancerProfile?
  clientProfile   ClientProfile?
  wallet          Wallet?
  auditLogs       AuditLog[]       @relation("ActorAuditLogs")
  sentMessages    Message[]        @relation("SentMessages")
  notifications   Notification[]
  disputesInitiated Dispute[]      @relation("DisputeInitiator")
  supportTickets  SupportTicket[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        RoleType         @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  module      String
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("login_attempts")
}

// -------------------------------------------------------------
// PROFILES
// -------------------------------------------------------------

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  headline    String?
  bio         String?
  country     String?
  city        String?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model FreelancerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  title              String
  overview           String?
  hourlyRate         Decimal            @default(0.00) @map("hourly_rate") @db.Decimal(10, 2)
  experienceLevel    ExperienceLevel    @default(INTERMEDIATE) @map("experience_level")
  rating             Decimal            @default(5.00) @db.Decimal(3, 2)
  reviewCount        Int                @default(0) @map("review_count")
  totalEarnings      Decimal            @default(0.00) @map("total_earnings") @db.Decimal(12, 2)
  completedJobsCount Int                @default(0) @map("completed_jobs_count")
  profileCompletion  Int                @default(20) @map("profile_completion")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  isTopRated         Boolean            @default(false) @map("is_top_rated")
  isFeatured         Boolean            @default(false) @map("is_featured")
  isAvailable        Boolean            @default(true) @map("is_available")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             UserSkill[]
  portfolioItems     PortfolioItem[]
  services           Service[]
  proposals          Proposal[]
  contracts          Contract[]
  receivedReviews    Review[]           @relation("FreelancerReviews")

  @@index([hourlyRate])
  @@index([rating])
  @@index([verificationStatus])
  @@map("freelancer_profiles")
}

model ClientProfile {
  id              String             @id @default(uuid())
  userId          String             @unique @map("user_id")
  companyName     String?            @map("company_name")
  companyWebsite  String?            @map("company_website")
  companySize     String?            @map("company_size")
  industry        String?
  totalSpent      Decimal            @default(0.00) @map("total_spent") @db.Decimal(12, 2)
  rating          Decimal            @default(5.00) @db.Decimal(3, 2)
  reviewCount     Int                @default(0) @map("review_count")
  taxId           String?            @map("tax_id")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs            Job[]
  contracts       Contract[]
  givenReviews    Review[]           @relation("ClientGivenReviews")

  @@map("client_profiles")
}

// -------------------------------------------------------------
// TAXONOMY (CATEGORIES & SKILLS)
// -------------------------------------------------------------

model Category {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  icon        String?
  parentId    String?         @map("parent_id")
  order       Int             @default(0)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")

  parent      Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]      @relation("CategoryHierarchy")
  skills      CategorySkill[]
  services    Service[]
  jobs        Job[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Skill {
  id          String          @id @default(uuid())
  name        String          @unique
  slug        String          @unique
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  categories  CategorySkill[]
  userSkills  UserSkill[]
  jobSkills   JobSkill[]

  @@index([slug])
  @@map("skills")
}

model CategorySkill {
  categoryId String   @map("category_id")
  skillId    String   @map("skill_id")

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([categoryId, skillId])
  @@map("category_skills")
}

model UserSkill {
  userId              String            @map("user_id")
  skillId             String            @map("skill_id")
  freelancerProfileId String            @map("freelancer_profile_id")
  yearsOfExperience   Int               @default(1) @map("years_of_experience")

  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerProfileId, skillId])
  @@map("user_skills")
}

// -------------------------------------------------------------
// PORTFOLIO
// -------------------------------------------------------------

model PortfolioItem {
  id                  String            @id @default(uuid())
  freelancerProfileId String            @map("freelancer_profile_id")
  title               String
  description         String
  projectUrl          String?           @map("project_url")
  imageUrl            String?           @map("image_url")
  technologies        String[]
  completionDate      DateTime?         @map("completion_date")
  createdAt           DateTime          @default(now()) @map("created_at")

  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@index([freelancerProfileId])
  @@map("portfolio_items")
}

// -------------------------------------------------------------
// SERVICES / GIGS (FIVERR MODEL)
// -------------------------------------------------------------

model Service {
  id                  String            @id @default(uuid())
  freelancerProfileId String            @map("freelancer_profile_id")
  categoryId          String            @map("category_id")
  title               String
  slug                String            @unique
  description         String
  coverImageUrl       String?           @map("cover_image_url")
  startingPrice       Decimal           @map("starting_price") @db.Decimal(10, 2)
  deliveryDays        Int               @default(3) @map("delivery_days")
  status              ServiceStatus     @default(PUBLISHED)
  rating              Decimal           @default(5.00) @db.Decimal(3, 2)
  reviewCount         Int               @default(0) @map("review_count")
  salesCount          Int               @default(0) @map("sales_count")
  tags                String[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packages            ServicePackage[]
  faqs                ServiceFaq[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([startingPrice])
  @@map("services")
}

model ServicePackage {
  id           String      @id @default(uuid())
  serviceId    String      @map("service_id")
  tier         PackageTier @default(BASIC)
  name         String
  description  String
  price        Decimal     @db.Decimal(10, 2)
  deliveryDays Int         @map("delivery_days")
  revisions    Int         @default(1)
  features     String[]

  service      Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, tier])
  @@map("service_packages")
}

model ServiceFaq {
  id        String  @id @default(uuid())
  serviceId String  @map("service_id")
  question  String
  answer    String

  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_faqs")
}

// -------------------------------------------------------------
// JOBS & PROPOSALS (UPWORK MODEL)
// -------------------------------------------------------------

model Job {
  id              String          @id @default(uuid())
  clientProfileId String          @map("client_profile_id")
  categoryId      String          @map("category_id")
  title           String
  slug            String          @unique
  description     String
  budgetType      BudgetType      @default(FIXED) @map("budget_type")
  budgetMin       Decimal?        @map("budget_min") @db.Decimal(10, 2)
  budgetMax       Decimal         @map("budget_max") @db.Decimal(10, 2)
  experienceLevel ExperienceLevel @default(INTERMEDIATE) @map("experience_level")
  durationWeeks   Int             @default(4) @map("duration_weeks")
  status          JobStatus       @default(PUBLISHED)
  proposalsCount  Int             @default(0) @map("proposals_count")
  isRemote        Boolean         @default(true) @map("is_remote")
  location        String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  clientProfile   ClientProfile   @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  skills          JobSkill[]
  proposals       Proposal[]
  contracts       Contract[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([budgetMax])
  @@map("jobs")
}

model JobSkill {
  jobId   String @map("job_id")
  skillId String @map("skill_id")

  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model Proposal {
  id                  String            @id @default(uuid())
  jobId               String            @map("job_id")
  freelancerProfileId String            @map("freelancer_profile_id")
  coverLetter         String            @map("cover_letter")
  bidAmount           Decimal           @map("bid_amount") @db.Decimal(10, 2)
  deliveryDays        Int               @map("delivery_days")
  status              ProposalStatus    @default(SUBMITTED)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  contract            Contract?

  @@unique([jobId, freelancerProfileId])
  @@index([jobId])
  @@index([freelancerProfileId])
  @@index([status])
  @@map("proposals")
}

// -------------------------------------------------------------
// CONTRACTS & MILESTONES
// -------------------------------------------------------------

model Contract {
  id                  String            @id @default(uuid())
  jobId               String?           @map("job_id")
  proposalId          String?           @unique @map("proposal_id")
  clientProfileId     String            @map("client_profile_id")
  freelancerProfileId String            @map("freelancer_profile_id")
  title               String
  contractType        BudgetType        @default(FIXED) @map("contract_type")
  totalAmount         Decimal           @map("total_amount") @db.Decimal(10, 2)
  status              ContractStatus    @default(ACTIVE)
  startDate           DateTime          @default(now()) @map("start_date")
  endDate             DateTime?         @map("end_date")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  job                 Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  proposal            Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  clientProfile       ClientProfile     @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Restrict)
  milestones          Milestone[]
  payments            Payment[]
  reviews             Review[]
  disputes            Dispute[]
  conversation        Conversation?

  @@index([clientProfileId])
  @@index([freelancerProfileId])
  @@index([status])
  @@map("contracts")
}

model Milestone {
  id          String          @id @default(uuid())
  contractId  String          @map("contract_id")
  title       String
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  dueDate     DateTime?       @map("due_date")
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
  payments    Payment[]

  @@index([contractId])
  @@index([status])
  @@map("milestones")
}

model Deliverable {
  id          String            @id @default(uuid())
  milestoneId String            @map("milestone_id")
  message     String
  fileUrls    String[]          @map("file_urls")
  status      DeliverableStatus @default(SUBMITTED)
  submittedAt DateTime          @default(now()) @map("submitted_at")

  milestone   Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("deliverables")
}

// -------------------------------------------------------------
// PAYMENTS, WALLET & FINANCIAL LEDGER
// -------------------------------------------------------------

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique @map("user_id")
  balance      Decimal             @default(0.00) @db.Decimal(12, 2)
  pendingFunds Decimal             @default(0.00) @map("pending_funds") @db.Decimal(12, 2)
  currency     String              @default("USD")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String          @id @default(uuid())
  walletId          String          @map("wallet_id")
  type              TransactionType
  amount            Decimal         @db.Decimal(12, 2)
  balanceAfter      Decimal         @map("balance_after") @db.Decimal(12, 2)
  description       String
  relatedPaymentId  String?         @map("related_payment_id")
  createdAt         DateTime        @default(now()) @map("created_at")

  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payment           Payment?        @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id             String              @id @default(uuid())
  contractId     String?             @map("contract_id")
  milestoneId    String?             @map("milestone_id")
  payerId        String              @map("payer_id")
  payeeId        String              @map("payee_id")
  amount         Decimal             @db.Decimal(10, 2)
  platformFee    Decimal             @default(0.00) @map("platform_fee") @db.Decimal(10, 2)
  netAmount      Decimal             @map("net_amount") @db.Decimal(10, 2)
  currency       String              @default("USD")
  status         PaymentStatus       @default(PENDING)
  idempotencyKey String              @unique @map("idempotency_key")
  providerTxId   String?             @map("provider_tx_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  contract       Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  milestone      Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  transactions   WalletTransaction[]
  invoices       Invoice[]

  @@index([contractId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number")
  paymentId     String   @map("payment_id")
  payerId       String   @map("payer_id")
  payeeId       String   @map("payee_id")
  subtotal      Decimal  @db.Decimal(10, 2)
  taxAmount     Decimal  @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(10, 2)
  currency      String   @default("USD")
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@map("invoices")
}

// -------------------------------------------------------------
// REVIEWS & DISPUTES
// -------------------------------------------------------------

model Review {
  id                  String            @id @default(uuid())
  contractId          String            @map("contract_id")
  reviewerId          String            @map("reviewer_id")
  clientProfileId     String?           @map("client_profile_id")
  freelancerProfileId String?           @map("freelancer_profile_id")
  rating              Decimal           @db.Decimal(3, 2)
  communicationScore  Int               @default(5) @map("communication_score")
  qualityScore        Int               @default(5) @map("quality_score")
  timelinessScore     Int               @default(5) @map("timeliness_score")
  comment             String
  createdAt           DateTime          @default(now()) @map("created_at")

  contract            Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientProfile       ClientProfile?    @relation("ClientGivenReviews", fields: [clientProfileId], references: [id], onDelete: SetNull)
  freelancerProfile   FreelancerProfile? @relation("FreelancerReviews", fields: [freelancerProfileId], references: [id], onDelete: SetNull)

  @@unique([contractId, reviewerId])
  @@index([contractId])
  @@index([rating])
  @@map("reviews")
}

model Dispute {
  id           String        @id @default(uuid())
  contractId   String        @map("contract_id")
  openedById   String        @map("opened_by_id")
  reason       String
  description  String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?     @map("resolved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openedBy     User          @relation("DisputeInitiator", fields: [openedById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([status])
  @@map("disputes")
}

// -------------------------------------------------------------
// MESSAGING & NOTIFICATIONS
// -------------------------------------------------------------

model Conversation {
  id           String    @id @default(uuid())
  contractId   String?   @unique @map("contract_id")
  title        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  attachmentUrls String[]     @map("attachment_urls")
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  targetUrl String?  @map("target_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// -------------------------------------------------------------
// AUDIT LOGS, SETTINGS & SUPPORT
// -------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  actor     User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("platform_settings")
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  subject     String
  description String
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("support_tickets")
}
